# Copy this file to .env and change the password and secret.
DATABASE_URL=mysql+pymysql://medikiosk:ChangeThisPassword@127.0.0.1:3306/medikiosk
JWT_SECRET=replace-with-a-long-random-secret-before-running
TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional real AI summary generation. Leave blank for offline template fallback.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
